{
  // Run with "Tasks: Run Task". Point Claude Code at the proxy with
  // "claudeCode.environmentVariables" (see README), then reload the window.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "safeagents: log-only",
      "type": "shell",
      "command": "uv",
      "args": ["run", "--project", "${workspaceFolder}", "safeagents", "--upstream", "https://api.anthropic.com", "--log-only"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false }
    },
    {
      "label": "safeagents: block",
      "type": "shell",
      "command": "uv",
      "args": ["run", "--project", "${workspaceFolder}", "safeagents", "--upstream", "https://api.anthropic.com"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false }
    }
  ]
}
